 application "Event Registration Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form College_Lookup
		{
			displayname = "College Lookup"
			success message = "College Lookup Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			participant
			(
				type = list	
				displayname = "Participant"
				values  = Event_Registration_Form.ID
    			displayformat = [registration_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			college_name
			(
				type = list	
				displayname = "College Name"
				values  = Colleges_Master.ID
    			displayformat = [college_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Colleges_Master
		{
			displayname = "Colleges Master"
			success message = "Colleges Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			college_code
			(
    			type = text
				displayname = "College Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			college_name
			(
    			type = text
				displayname = "College Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Event_Registration_Form
		{
			displayname = "Event Registration Form"
			success message = "Event Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			participant_first_name
			(
    			type = name
				displayname = "First Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			participant_last_name
			(
    			type = name
				displayname = "Last Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			participant_type
			(
				type = picklist
				displayname = "Participant Type"
				values = {"Faculty","Professional","Student"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			team_size
			(
				type = number
				displayname = "Team Size"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			college_organization_name
			(
    			type = text
				displayname = "College/Organization Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			institution_address
			(
    			type = address
				displayname = "Institution Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			expectations_from_event
			(
    			type = textarea
				displayname = "Expectations From Event"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			event_track
			(
				type = picklist
				displayname = "Event Track"
				values = {"Generative AI Track","Agentic Automation Track","AI & Data Science Track","Cloud Computing Track"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			areas_of_interest
			(
				type = list	
				displayname = "Areas Of Interest"
				values = {"Data Science","DevOps","Generative AI","Cloud Computing","Mobile Development","Agentic Automation","Web Development"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_session_date
			(
    			type = date
				displayname = "Preferred Session Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_session_slot
			(
    			type = time
				displayname = "Preferred Session Slot"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			agree_to_code_of_conduct
			(
    			type = checkbox
				displayname = "Agree To Code Of Conduct"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			requires_accommodation
			(
    			type = checkbox
				displayname = "Requires Accommodation"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			event_guidelines_display
			(
    			type = textarea
				displayname = "Event Guidelines Display"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			portfolio_linkedin_url
			(
    			type = url
				displayname = "Portfolio/LinkedIn URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			profile_photo
			(
    			type = text
				displayname = "Profile Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			early_bird_discount_percent
			(
    			type = percentage
				displayname = "Early Bird Discount Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_fee_paid
			(
				displayname = "Registration Fee Paid"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			academic_cgpa
			(
				type = decimal
				displayname = "Academic CGPA"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_submitted_on
			(
    			type = datetime
				displayname = "Registration Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_id
			(
    			type = autonumber
				displayname = "Registration ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_amount_payable
			(
				displayname = "Total Amount Payable"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			event_entry_qr_code
			(
    			type = text
				displayname = "Event Entry QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			participant_digital_signature
			(
    			type = text
				displayname = "Participant Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			id_proof_upload
			(
    			type = text
				displayname = "ID Proof Upload"
	 			row = 1
	 			column = 1   
				width = medium
			)
			special_requirement_voice_note
			(
    			type = text
				displayname = "Special Requirement Voice Note"
	 			row = 1
	 			column = 1   
				width = medium
			)
			team_intro_video
			(
    			type = text
				displayname = "Team Intro Video"
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_status
			(
				type = picklist
				displayname = "Payment Status"
				values = {"Failed","Paid","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			attendance_status
			(
				type = radiobuttons
				displayname = "Attendance Status"
				values = {"Not Attended","Attended"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			kit_collected
			(
    			type = checkbox
				displayname = "Kit Collected"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Pending Approval","Checked-In","No Show","Confirmed","Pending Payment"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Registration Draft","Pending Review","Approved","Rejected","Pending Payment","Payment Confirmed","Registration Approved","Pre-Event","Cancelled","Event Check-In","In Progress","Kit Collected","Completed","On Hold","Closed"}
			}
		}
		form Team_Members_Details
		{
			displayname = "Team Members Details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			participant
			(
				type = list	
				displayname = "Participant"
				values  = Event_Registration_Form.ID
    			displayformat = [registration_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			teammate_name
			(
    			type = name
				displayname = "Teammate Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			teammate_email
			(
    			type = email
				displayname = "Teammate Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			teammate_role
			(
    			type = text
				displayname = "Teammate Role"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list College_Lookup_Report
		{
			displayName = "All College Lookups"
			show all rows from College_Lookup    
			(
				participant as "Participant"
				college_name as "College Name"
			)
		}
		list Team_Members_Details_Report
		{
			displayName = "Team Members Details Report"
			show all rows from Team_Members_Details    
			(
				participant as "Participant"
				teammate_name  as "Teammate Name"
				teammate_email as "Teammate Email"
				teammate_role as "Teammate Role"
			)
		}
		list Colleges_Master_Report
		{
			displayName = "All Colleges Masters"
			show all rows from Colleges_Master    
			(
				college_code as "College Code"
				college_name as "College Name"
			)
		}
		list Event_Registration_Form_Report
		{
			displayName = "All Event Registrations"
			show all rows from Event_Registration_Form    
			(
				participant_first_name  as "First Name"
				participant_last_name  as "Last Name"
				participant_type as "Participant Type"
				team_size as "Team Size"
				email_address as "Email Address"
				institution_address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				contact_number as "Contact Number"
				college_organization_name as "College/Organization Name"
				expectations_from_event as "Expectations From Event"
				event_track as "Event Track"
				areas_of_interest as "Areas Of Interest"
				preferred_session_date as "Preferred Session Date"
				preferred_session_slot as "Preferred Session Slot"
				agree_to_code_of_conduct as "Agree To Code Of Conduct"
				requires_accommodation as "Requires Accommodation"
				event_guidelines_display as "Event Guidelines Display"
				portfolio_linkedin_url as "Portfolio/LinkedIn URL"
				profile_photo as "Profile Photo"
				early_bird_discount_percent as "Early Bird Discount Percent"
				(
					display = total,average,min,max	
				)
				registration_fee_paid as "Registration Fee Paid"
				(
					display = total,average,min,max	
				)
				academic_cgpa as "Academic CGPA"
				registration_submitted_on as "Registration Submitted On"
				registration_id as "Registration ID"
				total_amount_payable as "Total Amount Payable"
				(
					display = total,average,min,max	
				)
				event_entry_qr_code as "Event Entry QR Code"
				participant_digital_signature as "Participant Digital Signature"
				id_proof_upload as "ID Proof Upload"
				special_requirement_voice_note as "Special Requirement Voice Note"
				team_intro_video as "Team Intro Video"
				payment_status as "Payment Status"
				attendance_status as "Attendance Status"
				kit_collected as "Kit Collected"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Checked-In")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Confirmed")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "No Show")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban Event_Registration_Form_by_status
		{
			displayName = "Statuses"
			show all rows from Event_Registration_Form    
			(
				participant_first_name  as "First Name"
				participant_last_name  as "Last Name"
				participant_type as "Participant Type"
				team_size as "Team Size"
				email_address as "Email Address"
				institution_address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				contact_number as "Contact Number"
				college_organization_name as "College/Organization Name"
				expectations_from_event as "Expectations From Event"
				event_track as "Event Track"
				areas_of_interest as "Areas Of Interest"
				preferred_session_date as "Preferred Session Date"
				preferred_session_slot as "Preferred Session Slot"
				agree_to_code_of_conduct as "Agree To Code Of Conduct"
				requires_accommodation as "Requires Accommodation"
				event_guidelines_display as "Event Guidelines Display"
				portfolio_linkedin_url as "Portfolio/LinkedIn URL"
				profile_photo as "Profile Photo"
				early_bird_discount_percent as "Early Bird Discount Percent"
				(
					display = total,average,min,max	
				)
				registration_fee_paid as "Registration Fee Paid"
				(
					display = total,average,min,max	
				)
				academic_cgpa as "Academic CGPA"
				registration_submitted_on as "Registration Submitted On"
				registration_id as "Registration ID"
				total_amount_payable as "Total Amount Payable"
				(
					display = total,average,min,max	
				)
				event_entry_qr_code as "Event Entry QR Code"
				participant_digital_signature as "Participant Digital Signature"
				id_proof_upload as "ID Proof Upload"
				special_requirement_voice_note as "Special Requirement Voice Note"
				team_intro_video as "Team Intro Video"
				payment_status as "Payment Status"
				attendance_status as "Attendance Status"
				kit_collected as "Kit Collected"
				status as "Status"
			)
			options
			(
	 			display field = status
	 		)
		}
	}
	pages
	{
		page DashBoard
