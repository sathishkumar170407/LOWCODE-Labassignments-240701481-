		workflow
		{
		form
		{
			calculate_total_registration_fee as "Calculate Total Registration Fee"
			{
				type =  form
				form = Event_Registration_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Auto-calculate total fee based on discount and base rate upon form load
										// Get base registration fee
										baseFee = input.registration_fee_paid;
										// Get early bird discount percentage
										earlyBirdDiscount = input.early_bird_discount_percent;
										// Initialize total amount payable
										if(baseFee.isNull())
										{
											totalAmount = 0;
										}
										else
										{
											// Convert base fee to decimal for calculation
											baseFeeDecimal = baseFee.toDecimal();
											// Convert discount percentage to decimal (divide by 100)
											discountDecimal = earlyBirdDiscount.toDecimal();
											// Calculate discount amount
											discountAmount = baseFeeDecimal * discountDecimal / 100;
											// Calculate total amount payable
											totalAmount = baseFeeDecimal - discountAmount;
										}
										// Set the calculated total amount to the form field
										input.total_amount_payable = totalAmount;
										// Log the calculation for debugging
										info "Base Fee: " + baseFee + ", Discount: " + earlyBirdDiscount + ", Total Amount: " + totalAmount;
						)
					}
				}

			}
			validate_code_of_conduct as "Validate Code of Conduct Agreement"
			{
				type =  form
				form = Event_Registration_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if user has agreed to the code of conduct
										if(input.agree_to_code_of_conduct == false)
										{
											// Display error message to user
											alert "You must agree to the code of conduct to proceed with registration.";
											// Cancel the form submission
											cancel submit;
										}
						)
					}
				}

			}
			send_registration_confirmation as "Send Confirmation Email on Registration"
			{
				type =  form
				form = Event_Registration_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the registration ID from the submitted form
										registrationId = input.registration_id;
										// Get participant's email address
										participantEmail = input.email_address;
										// Get participant's first and last name from NAME composite field
										participantFirstName = input.participant_first_name.first_name;
										participantLastName = input.participant_last_name.last_name;
										// Construct email subject
										emailSubject = "Event Registration Confirmation - Registration ID: " + registrationId.toText();
										// Construct email body message
										emailMessage = "<p>Dear " + participantFirstName + " " + participantLastName + ",</p>" + "<p>Your event registration has been successfully submitted.</p>" + "<p><strong>Registration ID:</strong> " + registrationId + "</p>" + "<p>Please keep this ID for your records and future reference.</p>" + "<p>Thank you for registering!</p>";
										// Send confirmation email
										sendmail
										[
											from :zoho.loginuserid
											to :participantEmail
											subject :emailSubject
											message :emailMessage
											content type :HTML
										]
										// Display success message
										success message "Registration submitted successfully. Confirmation email sent.";
						)
					}
				}

			}
		}

		schedule
		{
			daily_payment_status_reminder as "Daily Payment Status Reminder"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all records with payment status as Pending
										pendingRecords = Event_Registration_Form[payment_status == "Pending"];
										// Check if there are any pending records
										if(pendingRecords.count() > 0)
										{
											// Iterate through each pending record
											for each  record in pendingRecords
											{
												// Get the participant's email address
												participantEmail = record.email_address;
												// Validate email is not null or empty
												if(!participantEmail.isNull() && !participantEmail.isEmpty())
												{
													// Get participant's first name for personalization
													participantFirstName = record.participant_first_name.first_name;
													// Get registration ID
													registrationId = record.registration_id;
													// Send notification email
													sendmail
													[
														from :zoho.loginuserid
														to :participantEmail
														subject :"Reminder: Pending Payment for Event Registration"
														message :"Dear " + participantFirstName + ",\n\nThis is a reminder that your payment for event registration (ID: " + registrationId.toString() + ") is still pending.\n\nPlease complete your payment at your earliest convenience to secure your spot.\n\nThank you!\n\nBest regards,\nEvent Registration Team"
													]
												}
											}
										}
					)
					}
				}
			}
		}


